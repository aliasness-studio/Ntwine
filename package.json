{
  "name": "ntwine",
  "productName": "Ntwine",
  "version": "0.1.3",
  "description": "Desktop browser for an orphaned Splice sample library — search, filter, preview, drag into your DAW.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mac": "electron-forge make --platform darwin --arch universal",
    "make:win": "electron-forge make --platform win32 --arch x64",
    "publish": "electron-forge publish",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "typecheck": "tsc --noEmit",
    "icons": "electron scripts/build-icons.mjs",
    "lint": "eslint .",
    "e2e": "electron-forge package && yarn e2e:only",
    "e2e:only": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/@playwright/test/cli.js test --project default",
    "e2e:real": "cross-env NTWINE_E2E_REAL=1 ELECTRON_RUN_AS_NODE=1 electron ./node_modules/@playwright/test/cli.js test --project real"
  },
  "keywords": [
    "splice",
    "samples",
    "sample-browser",
    "music-production",
    "electron"
  ],
  "homepage": "https://aliasness.studio/ntwine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliasness-studio/Ntwine.git"
  },
  "bugs": {
    "url": "https://github.com/aliasness-studio/Ntwine/issues"
  },
  "author": {
    "name": "AliasNess Studio",
    "email": "aliasness.studio@proton.me"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5",
    "cross-env": "^10.1.0",
    "electron": "43.4.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3",
    "audio-decode": "^3.12.0",
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^19",
    "react-dom": "^19",
    "styled-components": "^6"
  }
}
